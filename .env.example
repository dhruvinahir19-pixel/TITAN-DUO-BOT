# TITAN DUO v4.0 APEX - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or set these in your Render Environment Variables dashboard

# Neon.tech Serverless Postgres (Pooled connection URL)
DATABASE_URL=postgresql://user:password@ep-ancient-sun-b36ed6k4-pooler.c-4.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Base Account Risk (Apex tier: 0.03 for 3.0%, Ultra-safe: 0.025 for 2.5%)
BASE_RISK_PCT=0.03

# Web Server Port
PORT=8000

# CoinSwitch Pro API Credentials (Configured in Phase 4)
COINSWITCH_API_KEY=your_api_key_here
COINSWITCH_SECRET_KEY=your_secret_key_here
COINSWITCH_PROXY_URL=https://your-worker.your-domain.workers.dev

# Telegram Bot Credentials (Configured in Phase 5)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
ADMIN_PASSWORD=your_secure_dashboard_password_here
